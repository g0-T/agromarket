{
  "name": "jr-agro-marketplace-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate --schema=./prisma/schema.prisma && tsx --watch --env-file=.env src/index.ts",
    "seed": "tsx --env-file=.env src/prisma/seed.ts",
    "seed:test": "tsx --env-file=.env.test src/prisma/seed.ts",
    "seed:massive": "tsx --env-file=.env src/prisma/seed-massive.ts",
    "prepare": "ts-patch install -y",
    "build": "prisma generate --schema=./prisma/schema.prisma && ts-patch install -y && tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate"
  },
  "main": "dist/index.js",
  "license": "MIT",
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^10.51.0",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.0",
    "better-auth": "^1.5.6",
    "@better-auth/kysely-adapter": "^1.5.6",
    "kysely": "^0.28.15",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dompurify": "^3.0.5",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "jsdom": "^22.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prisma": "^6.1.0",
    "resend": "^6.9.4",
    "socket.io": "^4.8.1",
    "twilio": "^5.13.0",
    "uuid": "^13.0.0",
    "winston": "^3.9.0",
    "zod": "^4.3.6",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/hpp": "^0.2.7",
    "@types/jsdom": "^28.0.0",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.20.0",
    "ts-patch": "^3.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.1.3",
    "typescript-transform-paths": "^3.5.6"
  },
  "overrides": {
    "html-encoding-sniffer": "3.0.0"
  },
  "depcheck": {
    "ignoreMatches": [
      "k6"
    ]
  }
}