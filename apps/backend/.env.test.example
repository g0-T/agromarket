# Test-specific environment variables for the backend.
# Copy this file to .env.test and update values before running pnpm run seed:test.

DATABASE_CONNECTION_STRING="postgresql://postgres:11111111@localhost:5432/jr_agro_test?schema=public"
BETTER_AUTH_SECRET="replace_with_test_secret"
REFRESH_SECRET="replace_with_test_secret"
CHAT_ENCRYPTION_KEY="replace_with_test_secret"
STORAGE_PROVIDER="local"
STORAGE_CONNECTION_STRING="./uploads"
BACKEND_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"
